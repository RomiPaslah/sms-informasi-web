<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # Prevent applying rules to index.php itself
  RewriteRule ^index\.php$ - [L]

  # Allow public_html/api/ direct access
  RewriteCond %{REQUEST_URI} ^/api/ [NC]
  RewriteRule ^ - [L]

  # Redirect non-existent files to index.php (Dynamic SSR)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.php [L]
</IfModule>