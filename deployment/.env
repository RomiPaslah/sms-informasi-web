# Environment Variables untuk SMS Informasi Web
# Salin file ini menjadi .env dan isi dengan nilai yang sesuai

# Google OAuth Client ID
# Dapatkan dari: https://console.cloud.google.com/
# 1. Buat project baru atau pilih project existing
# 2. Enable "Google Identity Services API"
# 3. Buat OAuth 2.0 Client ID → Web application
# 4. Set Authorized JavaScript origins: https://yourdomain.com
# 5. Set Authorized redirect URIs: (kosongkan untuk web apps)
# 6. Copy Client ID dan paste di bawah ini

VITE_GOOGLE_CLIENT_ID=your_actual_google_client_id_here
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# Contoh:
# VITE_GOOGLE_CLIENT_ID=123456789-abcdefghijklmnopqrstuvwxyz.apps.googleusercontent.com